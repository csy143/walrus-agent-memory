# Sui Configuration
SUI_RPC_URL=http://localhost:9000
SUI_PACKAGE_ID=your_package_id_here
SUI_PRIVATE_KEY=your_private_key_here

# Walrus Configuration
WALRUS_ENDPOINT=http://localhost:31415
WALRUS_TIMEOUT=30000

# API Server
PORT=3000
NODE_ENV=development

# Encryption
ENCRYPTION_ENABLED=false
ENCRYPTION_ALGORITHM=XChaCha20-Poly1305

# Cache
CACHE_ENABLED=true
CACHE_TTL=3600000
CACHE_MAX_SIZE=100
